# ============================================================
# 環境変数の見本（このファイルだけはコミットしてよい）
# ============================================================
# 手元で使うときは .env にコピーして値を入れ、起動時に読み込む:
#   uvicorn backend.api:app --env-file .env
# .env は .gitignore 済み。ここにも .env にも、実名・鍵をコミットしないこと。
# Render では、ダッシュボードの Environment で同じ名前の変数を設定する。
# ============================================================

# API の説明ページ（/docs・/redoc・/openapi.json）を出すか。既定は 0（出さない）。
# 手元で API を試すときだけ 1 にする。公開サービス（Render）では設定しない。
ENABLE_API_DOCS=0

# カテゴリの設定（README の「カテゴリの設定」）。どちらも無ければ private/categories.json、それも無ければ見本を使う。
# 実際のカテゴリ名・判定語は、ここ（見本のファイル）には書かない。Render では CATEGORY_CONFIG_JSON に1行の JSON を貼る。
# CATEGORY_CONFIG_JSON={"version":1,"default":"暮らし","categories":[{"name":"暮らし","color":4,"keywords":["買い物"]}]}
# CATEGORY_CONFIG_FILE=private/categories.json
